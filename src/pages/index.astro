---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main" class="shell section">
    <p class="eyebrow">MTK / SYSTEMS OBSERVATORY</p>
    <h1>
      Information.
      <br />
      <span class="accent">Made useful.</span>
    </h1>
    <p>
      Software engineering and applied AI. A foundation for exploring the
      systems behind the interface.
    </p>
    <div class="rule section">
      <h2>Built with intention.</h2>
      <p class="muted">
        Space Grotesk, a quiet technical palette, and room to think.
      </p>
      <a class="button" href="https://github.com/TahubCS">
        Explore GitHub ↗
      </a>
    </div>
  </main>
</BaseLayout>
