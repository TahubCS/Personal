---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ContextTrace from '../features/context-trace/ContextTrace';
import TraceTranscript from '../features/context-trace/TraceTranscript.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <section id="trace" class="shell section">
      <p class="eyebrow">Inside the system / Context Compiler</p>
      <h2>Follow the question.</h2>
      <p class="muted">
        An agent needs more than a repository. It needs the right pieces of it.
        Explore how a search moves through authentication, embeddings, and
        retrieval to become useful context.
      </p>
      <ContextTrace client:visible />
      <TraceTranscript />
    </section>
    <section id="about" class="shell section rule">
      <h2>
        Curious about what
        <br />
        happens underneath.
      </h2>
      <p class="muted">
        I’m interested in NLP, AI agents, and the engineering that makes them
        useful.
      </p>
    </section>
  </main>
</BaseLayout>
