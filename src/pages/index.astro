---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <section id="stories" class="shell section">
      <p class="eyebrow">01 / Selected work</p>
      <h2>Systems with a purpose.</h2>
      <p class="muted">
        Repository context. Customer support. Collaborative learning.
      </p>
    </section>
    <section id="about" class="shell section rule">
      <h2>
        Curious about what
        <br />
        happens underneath.
      </h2>
      <p class="muted">
        I’m interested in NLP, AI agents, and the engineering that makes them
        useful.
      </p>
    </section>
  </main>
</BaseLayout>
