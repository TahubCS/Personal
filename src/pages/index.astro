---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ContextTrace from '../features/context-trace/ContextTrace';
import TraceTranscript from '../features/context-trace/TraceTranscript.astro';
import ProjectStory from '../components/ProjectStory.astro';
import { projects } from '../data/projects';
import ContactFooter from '../components/ContactFooter.astro';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <section id="trace" class="shell section trace-section">
      <div class="trace-handoff">
        <div class="project-intro">
          <p class="eyebrow">Inside the system / Context Compiler</p>
          <h2>Follow the question.</h2>
          <p class="muted intro">
            An agent needs more than a repository. It needs the right pieces of
            it. Explore how a search moves through authentication, embeddings,
            and retrieval to become useful context.
          </p>
        </div>
        <div class="handoff-question" aria-label="Question handoff">
          <span class="thread" aria-hidden="true"></span>
          <p class="eyebrow">Question / Natural language</p>
          <h3 class="question-title">
            Where is access
            <br />
            resolved?
          </h3>
          <p class="technical">Question → useful context</p>
        </div>
      </div>
      <div class="trace-runway">
        <ContextTrace client:visible />
      </div>
      <TraceTranscript />
    </section>
    <div class="paper-portal" data-motion="paper" aria-hidden="true">
      <div class="portal-sheet">
        <span class="portal-datum portal-datum--tl">+</span>
        <span class="portal-datum portal-datum--tr">+</span>
        <span class="portal-datum portal-datum--bl">+</span>
        <span class="portal-datum portal-datum--br">+</span>
        <span class="eyebrow">Context / becomes</span>
        <span class="portal-word">Useful.</span>
        <span class="portal-foot">One working set. Many possibilities.</span>
        <span class="portal-spec">
          DRAWING REF · SC—002 · SPECIFICATION SHEET
        </span>
      </div>
    </div>
    <section id="stories" class="paper">
      <div class="shell section">
        <p class="eyebrow">Selected work / 01—03</p>
        <h2>Built around real questions.</h2>
        <p>
          Each project explores a different interface between information and
          people. Here are the systems, the decisions behind them, and the
          contributions I can point to in code.
        </p>
        {projects.map((project) => (
          <ProjectStory project={project} />
        ))}
      </div>
    </section>
    <div class="return-portal" data-motion="return" aria-hidden="true">
      <span>Information → product → contribution</span>
      <i></i>
    </div>
    <section id="about" class="shell section rule">
      <h2 aria-label="Curious about what happens underneath">
        <span>Curious about what</span>{' '}
        <span class="line-break">happens underneath.</span>
      </h2>
      <p class="muted">
        At East Carolina University, my interests sit between software
        engineering and applied AI: how information is retrieved, how an agent
        uses it, and how a person understands the result. I enjoy following a
        feature across the interface, API, and data layer instead of treating
        those boundaries as separate problems.
      </p>
      <p class="muted">
        These projects reflect that curiosity. They have led me into repository
        indexing, embeddable SDKs, and streaming study tools. I care about
        making the implementation inspectable, naming its limitations, and
        keeping the experience clear enough that someone else can use it. I’m
        looking to deepen that work with a team building useful systems.
      </p>
    </section>
  </main>
  <ContactFooter />
</BaseLayout>
