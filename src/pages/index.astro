---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ContextTrace from '../features/context-trace/ContextTrace';
import TraceTranscript from '../features/context-trace/TraceTranscript.astro';
import ProjectStory from '../components/ProjectStory.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <section id="trace" class="shell section">
      <p class="eyebrow">Inside the system / Context Compiler</p>
      <h2>Follow the question.</h2>
      <p class="muted">
        An agent needs more than a repository. It needs the right pieces of it.
        Explore how a search moves through authentication, embeddings, and
        retrieval to become useful context.
      </p>
      <ContextTrace client:visible />
      <TraceTranscript />
    </section>
    <section id="stories" class="paper">
      <div class="shell section">
        <p class="eyebrow">Selected work / 01—03</p>
        <h2>Built around real questions.</h2>
        <p>
          Each project explores a different interface between information and
          people. Here are the systems, the decisions behind them, and the
          contributions I can point to in code.
        </p>
        {projects.map((project) => (
          <ProjectStory project={project} />
        ))}
      </div>
    </section>
    <section id="about" class="shell section rule">
      <h2>
        Curious about what
        <br />
        happens underneath.
      </h2>
      <p class="muted">
        I’m interested in NLP, AI agents, and the engineering that makes them
        useful.
      </p>
    </section>
  </main>
</BaseLayout>
