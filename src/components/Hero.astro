---
import { profile } from '../data/profile';
import ProjectIndex from './ProjectIndex.astro';
import SystemArtifact from './SystemArtifact.astro';
---

<section class="hero shell" data-motion="hero" aria-labelledby="identity">
  <div class="hero-top eyebrow">
    <span>Portfolio / Selected systems</span>
    <span>East Carolina University</span>
  </div>
  <div class="hero-grid">
    <div class="identity">
      <p class="eyebrow intro-label">Hello, I'm</p>
      <h1 id="identity" aria-label="Muhammad Tahub Khatri">
        <span class="name-first">Muhammad</span>{' '}
        <span class="line-break">
          Tahub <em>Khatri.</em>
        </span>
      </h1>
      <p class="intro">{profile.introduction}</p>
      <p class="availability">
        <span aria-hidden="true"></span>
        {profile.availability}
      </p>
      <div class="actions">
        <a class="button primary" href="#work">
          Explore my work ↓
        </a>
        <a class="text-link" href={profile.github}>
          Connect on GitHub ↗
        </a>
      </div>
    </div>
    <ProjectIndex />
    <SystemArtifact />
  </div>
  <div class="hero-route">
    <span class="eyebrow">One question. Follow its path.</span>
    <a href="#trace">Enter the system ↓</a>
  </div>
</section>
<style>
  .hero {
    padding-top: 32px;
  }
  .hero-top,
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .hero-top {
    margin-bottom: 32px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 7%;
    align-items: center;
    grid-template-areas: 'identity study' 'index index';
  }
  .identity {
    grid-area: identity;
    min-width: 0;
  }
  .intro-label {
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(56px, 6.8vw, 98px);
    margin-bottom: 28px;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro {
    color: var(--muted);
    max-width: 47ch;
    font-size: 18px;
  }
  .availability {
    font-size: 13px;
    margin: 24px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .availability > span {
    width: 6px;
    height: 6px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .text-link {
    align-self: center;
    font-size: 14px;
    padding: 12px 0;
  }
  .hero-bottom {
    margin-top: 60px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1023px) {
    .hero-grid {
      gap: 32px;
      grid-template-columns: 1.2fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .hero-top {
      margin-bottom: 34px;
      font-size: 10px;
    }
    .hero-top span:last-child {
      display: none;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'identity' 'index' 'study';
    }
    .intro {
      font-size: 16px;
    }
    h1 {
      font-size: clamp(42px, 11.7vw, 76px);
    }
    .availability {
      font-size: 12px;
    }
  }
</style>
