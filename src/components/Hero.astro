---
import { profile } from '../data/profile';
import ProjectIndex from './ProjectIndex.astro';
import HeroCore from './HeroCore.astro';
---

<section class="hero shell" data-motion="hero" aria-labelledby="identity">
  <div class="hero-runway">
    <div class="hero-pin">
      <div class="hero-top eyebrow">
        <span>Portfolio / Selected systems</span>
        <span>East Carolina University</span>
      </div>
      <div class="hero-opening">
        <div class="identity">
          <p class="eyebrow intro-label">Hello, I'm</p>
          <h1 id="identity" aria-label="Muhammad Tahub Khatri">
            <span class="name-first">Muhammad</span>{' '}
            <span class="line-break">
              Tahub <em>Khatri.</em>
            </span>
          </h1>
          <p class="intro">{profile.introduction}</p>
          <p class="availability">
            <span aria-hidden="true"></span>
            {profile.availability}
          </p>
          <div class="actions">
            <a class="button primary" href="#work">
              Explore my work ↓
            </a>
            <a class="text-link" href={profile.github}>
              Connect on GitHub ↗
            </a>
          </div>
        </div>
        <HeroCore />
      </div>
    </div>
  </div>
  <ProjectIndex />
</section>
<style>
  .hero {
    padding-top: 32px;
  }
  .hero-top,
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .hero-top {
    margin-bottom: 32px;
  }
  .hero-opening {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    column-gap: 6%;
    row-gap: 32px;
    align-items: center;
    grid-template-areas: 'identity study';
    position: relative;
  }
  .identity {
    grid-area: identity;
    min-width: 0;
  }
  .intro-label {
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(56px, 6.8vw, 98px);
    margin-bottom: 28px;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--accent);
    font-style: normal;
  }
  .intro {
    color: var(--muted);
    max-width: 47ch;
    font-size: 18px;
  }
  .availability {
    font-size: 13px;
    margin: 24px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .availability > span {
    width: 6px;
    height: 6px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .text-link {
    align-self: center;
    font-size: 14px;
    padding: 12px 0;
  }
  .hero-bottom {
    margin-top: 60px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1023px) {
    .hero-opening {
      gap: 32px;
      grid-template-columns: 1.2fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .hero-top {
      margin-bottom: 34px;
      font-size: 10px;
    }
    .hero-top span:last-child {
      display: none;
    }
    .hero-opening {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'identity' 'study';
    }
    .intro {
      font-size: 16px;
    }
    h1 {
      font-size: clamp(42px, 11.7vw, 76px);
    }
    .availability {
      font-size: 12px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-opening:not([data-static]) {
      --opening-travel: min(60svh, 540px);
      min-height: calc(var(--opening-height, 580px) + var(--opening-travel));
      grid-template-rows: 1fr;
    }
    .hero-opening:not([data-static]) .identity {
      position: sticky;
      top: var(--identity-pin-top, 209px);
      align-self: start;
      margin-top: 44px;
    }
  }
  .hero-runway,
  .hero-pin {
    display: contents;
  }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .hero-runway {
      display: block;
      min-height: calc(var(--composition-height, 630px) + min(60svh, 540px));
    }
    .hero-pin {
      display: block;
      position: sticky;
      top: var(--hero-pin-top, 113px);
    }
    .hero-opening:not([data-static]) {
      min-height: 0;
    }
    .hero-opening:not([data-static]) .identity,
    .hero-opening :global(.hero-core) {
      position: static;
    }
    .hero-runway:has([data-static]) {
      min-height: 0;
    }
    .hero-runway:has([data-static]) .hero-pin {
      position: static;
    }
  }
  @media (max-width: 1023px) {
    .hero-opening:not([data-static]) .identity {
      margin-top: 0;
    }
  }
  @media (max-width: 767px) {
    .hero-opening:not([data-static]) {
      --opening-travel: min(42svh, 360px);
      --opening-height: 780px;
      grid-template-rows: auto 1fr;
    }
    .hero-opening:not([data-static]) .identity {
      position: static;
    }
  }
</style>
<noscript>
  <style is:global>
    .hero-runway,
    .hero-opening {
      min-height: 0 !important;
    }
    .hero-pin,
    .hero-opening .identity,
    .hero-opening .hero-core {
      position: static !important;
    }
  </style>
</noscript>
