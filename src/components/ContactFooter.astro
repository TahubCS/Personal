---
import { profile } from '../data/profile';
---

<footer id="contact" class="contact-footer" data-motion="contact">
  <div class="shell section">
    <div class="closing-request" aria-hidden="true">
      <span class="request-marker"></span>
      <span>Question → system → context → contribution</span>
      <span>↗</span>
    </div>
    <p class="eyebrow">Open to the next challenge</p>
    <div class="contact-grid">
      <h2 aria-label="Let's build something useful">
        <span>Let's build</span>{' '}
        <span class="accent line-break">something useful.</span>
      </h2>
      <div>
        <p>
          I’m looking for an internship where I can contribute to thoughtful
          software and applied AI, learn from an experienced team, and take
          responsibility for work that matters.
        </p>
        <a class="button primary" href={profile.github}>
          Find me on GitHub ↗
        </a>
      </div>
    </div>
    <div class="footer-line">
      <span>{profile.name}</span>
      <span class="eyebrow">Software engineering / Applied AI</span>
      <a href="#main">Back to top ↑</a>
    </div>
  </div>
</footer>
<style>
  .contact-footer {
    border-top: 1px solid var(--line);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 8%;
    align-items: center;
  }
  .contact-grid h2 {
    font-size: clamp(36px, 5vw, 68px);
  }
  .contact-grid p {
    color: var(--muted);
    font-size: 16px;
  }
  .footer-line {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    font-size: 13px;
  }
  .footer-line a {
    padding: 12px 0;
  }
  @media (max-width: 767px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .footer-line {
      flex-direction: column;
      align-items: start;
      margin-top: 40px;
    }
  }
</style>
