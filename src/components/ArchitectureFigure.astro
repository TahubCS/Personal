---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<figure class:list={['architecture', project.slug]}>
  <div class="figure-top eyebrow">
    <span>Fig. {project.number} / Process study</span>
    <span>Architecture illustration</span>
  </div>
  {project.slug === 'context-compiler' ? (
    <div class="retrieval-study">
      <div class="source-sheets">
        <div>
          <span>01 / Source</span>
          <strong>GitHub repository</strong>
        </div>
        <div>
          <span>02 / Prepare</span>
          <strong>Scan &amp; embed</strong>
        </div>
        <div>
          <span>03 / Select</span>
          <strong>Hybrid retrieval</strong>
        </div>
      </div>
      <div class="assembled-sheet">
        <span class="eyebrow">04 / Context pack</span>
        <strong>
          The useful
          <br />
          working set.
        </strong>
        <span>Paths + excerpts + selection metadata</span>
        <span class="artifact-stamp">Agent context</span>
      </div>
    </div>
  ) : project.slug === 'supo' ? (
    <ol class="conversation-study">
      <li>
        <span class="eyebrow">01 / Customer message</span>
        <strong>
          A question starts
          <br />
          the conversation.
        </strong>
      </li>
      <li>
        <span class="eyebrow">02 / Knowledge retrieval</span>
        <strong>Product context</strong>
        <span>Knowledge → streamed AI response</span>
      </li>
      <li class="handoff-boundary">
        <span class="eyebrow">03 / AI → human</span>
        <strong>
          Keep the context.
          <br />
          Change the responder.
        </strong>
        <span>Human handoff · conversation continuity</span>
      </li>
    </ol>
  ) : (
    <div class="learning-study">
      <div class="material-stack">
        <span class="material-page">Course materials</span>
        <span class="material-page">Extract &amp; review</span>
        <span class="material-page">Class retrieval</span>
      </div>
      <div class="resource-hub">
        <span class="eyebrow">Shared context</span>
        <strong>
          Learn from
          <br />
          the same source.
        </strong>
        <ul>
          <li>Study plans</li>
          <li>Flashcards</li>
          <li>Tutor context</li>
        </ul>
      </div>
    </div>
  )}
  <figcaption>
    {project.slug === 'supo'
      ? 'Conversation continuity across an AI-to-human boundary.'
      : project.slug === 'crowsnest'
        ? 'From a shared material to class-specific study context.'
        : 'Index preparation and query handling are separate paths.'}
  </figcaption>
</figure>
