---
import '../../styles/tokens.css';
import exposed from './exposed.webp?url';
import { profile } from '../../data/profile';
import ProjectIndex from '../../components/ProjectIndex.astro';
import ContextTrace from '../../features/context-trace/ContextTrace';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Core → Context Compiler / Static handoff review</title>
  </head>
  <body>
    <nav class="review-nav" aria-label="Storyboard frames">
      <strong>Static handoff proposal</strong>
      <a href="#held">01 / Hold</a>
      <a href="#handoff">02 / Handoff</a>
      <a href="#trace-frame">03 / Trace</a>
      <a href="/">Portfolio ↗</a>
    </nav>
    <main>
      <section id="held" aria-labelledby="held-title">
        <header class="review-note">
          <h1 id="held-title">01 / The exposed core holds</h1>
          <p>
            The upper composition remains together. Selected projects arrive
            below it.
          </p>
        </header>
        <div class="frame held">
          <div class="topline">
            <span>Portfolio / Selected systems</span>
            <span>East Carolina University</span>
          </div>
          <div class="pair">
            <div>
              <p class="eyebrow">Hello, I'm</p>
              <h2 class="identity">
                Muhammad
                <br />
                Tahub <em>Khatri.</em>
              </h2>
              <p class="intro">{profile.introduction}</p>
              <p class="availability">{profile.availability}</p>
              <a class="work-link" href="/#work">
                Explore my work ↓
              </a>
            </div>
            <figure>
              <img
                src={exposed}
                width="579"
                height="540"
                alt="The approved core in its exposed arrangement"
              />
              <figcaption>System core / Original study</figcaption>
            </figure>
          </div>
          <ProjectIndex />
        </div>
      </section>
      <section id="handoff" aria-labelledby="handoff-title">
        <header class="review-note">
          <h2 id="handoff-title">02 / The project enters</h2>
          <p>
            The core leaves upward as one object. The amber alignment continues
            into a real software question; no mechanical layer becomes an API
            stage.
          </p>
        </header>
        <div class="frame handoff">
          <div class="outgoing">
            <img
              src={exposed}
              width="579"
              height="540"
              alt="The core leaving the composition above the project introduction"
            />
          </div>
          <div class="incoming pair">
            <div class="project-intro">
              <p class="eyebrow">Inside the system / Context Compiler</p>
              <h2>
                Follow the
                <br />
                question.
              </h2>
              <p class="intro">
                An agent needs more than a repository. It needs the right pieces
                of it. Explore how a search moves through authentication,
                embeddings, and retrieval to become useful context.
              </p>
            </div>
            <div class="question">
              <span class="thread" aria-hidden="true"></span>
              <p class="eyebrow">Question / Natural language</p>
              <h3>
                Where is access
                <br />
                resolved?
              </h3>
              <p class="technical">Question → useful context</p>
            </div>
          </div>
        </div>
      </section>
      <section id="trace-frame" aria-labelledby="trace-title">
        <header class="review-note">
          <h2 id="trace-title">03 / The existing trace takes over</h2>
          <p>
            The core is gone. The question settles into the existing trace. This
            is its actual static markup; controls are intentionally inactive in
            this storyboard.
          </p>
        </header>
        <div class="frame settled">
          <p class="eyebrow">Inside the system / Context Compiler</p>
          <h2>Follow the question.</h2>
          <p class="intro">
            An agent needs more than a repository. It needs the right pieces of
            it. Explore how a search moves through authentication, embeddings,
            and retrieval to become useful context.
          </p>
          <ContextTrace />
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg);
    scroll-padding-top: 90px;
  }
  body {
    margin: 0;
    color: var(--text);
    font: 16px/1.6 var(--body);
  }
  a {
    color: inherit;
    text-underline-offset: 5px;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .review-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 16px 4vw;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    font: 12px/1.7 var(--mono);
  }
  .review-nav strong {
    margin-right: auto;
  }
  .review-note {
    padding: 32px 4vw;
    background: #202a2d;
  }
  .review-note h1,
  .review-note h2 {
    font: 500 22px/1.3 var(--display);
    margin: 0 0 8px;
  }
  .review-note p {
    margin: 0;
    max-width: 85ch;
    color: var(--muted);
  }
  .frame {
    max-width: 1440px;
    min-height: 820px;
    padding: 48px 4%;
    margin: auto;
    position: relative;
    overflow: clip;
  }
  .topline,
  figcaption,
  .eyebrow,
  .technical {
    font: 11px/1.7 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .topline {
    display: flex;
    justify-content: space-between;
    margin-bottom: 46px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 6%;
    align-items: center;
  }
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.055em;
  }
  .identity {
    font-size: clamp(48px, 6.6vw, 94px);
    margin: 28px 0;
  }
  em {
    color: var(--accent);
    font-style: normal;
  }
  .intro {
    color: var(--muted);
    max-width: 48ch;
    font-size: 18px;
    line-height: 1.7;
  }
  .availability {
    font-size: 13px;
    margin: 26px 0;
  }
  .work-link {
    display: inline-block;
    padding: 12px 20px;
    background: var(--accent);
    color: var(--ink);
    text-decoration: none;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    color: var(--muted);
  }
  .held :global(.project-index) {
    margin-top: 48px;
  }
  .handoff {
    min-height: 860px;
  }
  .outgoing {
    position: absolute;
    width: 40%;
    right: 4%;
    top: -160px;
  }
  .outgoing img {
    width: 100%;
    height: auto;
  }
  .incoming {
    padding-top: 315px;
  }
  .project-intro h2,
  .settled > h2 {
    font-size: clamp(44px, 5.5vw, 76px);
    margin: 20px 0;
  }
  .question {
    position: relative;
    align-self: end;
    padding: 34px 0;
    border-block: 1px solid var(--line);
  }
  .question h3 {
    font-size: clamp(32px, 4vw, 55px);
    margin: 26px 0;
  }
  .thread {
    position: absolute;
    width: 1px;
    height: 100px;
    background: var(--accent);
    top: -100px;
    left: 50%;
  }
  .technical {
    color: var(--accent);
    text-transform: none;
  }
  .settled > .intro {
    max-width: 70ch;
    margin-bottom: 40px;
  }
  @media (max-width: 767px) {
    .review-nav {
      gap: 12px;
      font-size: 10px;
    }
    .review-nav strong {
      width: 100%;
    }
    .frame {
      padding: 32px 20px;
      min-height: 0;
    }
    .pair {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .topline span:last-child {
      display: none;
    }
    .identity {
      font-size: clamp(38px, 10.8vw, 68px);
    }
    .intro {
      font-size: 16px;
    }
    figure img {
      max-height: 280px;
      object-fit: contain;
    }
    .outgoing {
      width: 75%;
      right: 0;
      top: -110px;
    }
    .incoming {
      padding-top: 220px;
    }
    .question {
      margin-top: 30px;
    }
    .thread {
      height: 55px;
      top: -55px;
      left: 20px;
    }
  }
</style>
