---
import '../styles/global.css';
import '../styles/motion.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Muhammad Tahub Khatri — Software & Applied AI',
  description = 'Software engineering and applied AI. Explore repository context, support systems, and collaborative learning projects by Muhammad Tahub Khatri.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111719" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <noscript>
      <link rel="stylesheet" href="/no-script.css" />
    </noscript>
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      import { mountPageMotion } from '../features/scroll-narrative/page-motion';
      const cleanup = mountPageMotion();
      if (import.meta.hot) import.meta.hot.dispose(cleanup);
    </script>
  </body>
</html>
