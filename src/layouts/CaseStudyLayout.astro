---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ArchitectureFigure from '../components/ArchitectureFigure.astro';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
  title: string;
  description: string;
}
const { project, title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main id="main">
    <section class="shell case-hero">
      <a class="back-link" href="/#work">
        ← All projects
      </a>
      <p class="eyebrow">
        {project.number} / {project.category}
      </p>
      <h1>
        {project.name}
        <span class="accent">.</span>
      </h1>
      <p class="case-lead">{project.summary}</p>
      <div class="actions">
        <a class="button primary" href={project.repo}>
          Explore the repository ↗
        </a>
        <a class="button" href={project.url}>
          Visit application ↗
        </a>
      </div>
    </section>
    <section class="paper">
      <div class="shell case-body">
        <ArchitectureFigure project={project} />
        <div class="prose">
          <slot />
        </div>
        <div class="case-end rule">
          <p class="eyebrow">Continue exploring</p>
          <a href="/#work">Back to selected work ↗</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .case-hero {
    padding-block: 40px 80px;
  }
  .back-link {
    font-size: 14px;
    display: inline-block;
    margin-bottom: 48px;
  }
  .case-hero h1 {
    font-size: clamp(44px, 8vw, 108px);
    overflow-wrap: anywhere;
  }
  .case-lead {
    font-size: 24px;
    max-width: 40ch;
  }
  .case-body {
    padding-block: 64px;
  }
  .prose {
    max-width: 70ch;
    margin: 72px auto;
  }
  .prose :global(h2) {
    font-size: 32px;
    margin-top: 56px;
  }
  .prose :global(p) {
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .prose :global(a) {
    overflow-wrap: anywhere;
  }
  .prose :global(code) {
    font-size: 0.85em;
  }
  .case-end {
    padding-block: 32px;
  }
  @media (max-width: 767px) {
    .case-hero {
      padding-block: 28px 48px;
    }
    .case-lead {
      font-size: 20px;
    }
    .back-link {
      margin-bottom: 32px;
    }
    .prose {
      margin-block: 48px;
    }
    .prose :global(h2) {
      font-size: 28px;
    }
  }
</style>
